# Copia este archivo como .env y ajusta los valores
DATABASE_URL=postgresql://postgres:TU_CONTRASEÑA@localhost:5432/serenity_fatiga

# Zona horaria para agrupar por día y detectar la noche (nombre IANA)
LOCAL_TZ=America/Bogota

# Clave que exigen todas las rutas /api en la cabecera X-API-Key.
# Déjala vacía para una API abierta (solo en local). Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
